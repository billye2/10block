{
  "name": "10block",
  "version": "1.3.1",
  "private": true,
  "description": "Chrome extension: block the current website for 10 minutes.",
  "scripts": {
    "test": "playwright test",
    "release": "node scripts/release.mjs",
    "release:publish": "node scripts/release.mjs --publish",
    "icons": "python3 scripts/make_icons.py",
    "assets": "node marketing/capture.mjs && python3 scripts/make_icons.py --store marketing/store/store-icon-128.png"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0"
  }
}
